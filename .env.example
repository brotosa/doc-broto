# Ferramentas de IA (Resumir, Traduzir, PDF -> Markdown).
# Sem esta chave, as demais ferramentas continuam funcionando normalmente.
ANTHROPIC_API_KEY=

# Opcional: sobrescreve o modelo padrão (claude-opus-5).
# ANTHROPIC_MODEL=claude-opus-5

# Caminho do Chromium para HTML -> PDF (definido automaticamente na imagem Docker).
# CHROMIUM_PATH=/usr/bin/chromium

# =====================================================================
# Autenticação (login próprio + Postgres). Ver docs/AUTENTICACAO.md
# =====================================================================

# Conexão com o Postgres. Deixe EM BRANCO para usar um armazenamento
# EM MEMÓRIA (apenas desenvolvimento/local — os dados somem ao reiniciar).
# Em produção aponte para o Postgres (ex.: na mesma instância Lightsail):
#   postgres://broto:senha@localhost:5432/broto
DATABASE_URL=

# SSL do Postgres: "off" desativa (use para Postgres local). Padrão: exige SSL.
# PGSSL=off

# Segredo para assinar o cookie de sessão (gere uma string aleatória longa).
AUTH_SECRET=

# Primeiro administrador (criado automaticamente no primeiro acesso).
# O login é por E-MAIL.
ADMIN_EMAIL=admin@suaempresa.com.br
ADMIN_PASSWORD=troque-esta-senha
ADMIN_NAME=Administrador
